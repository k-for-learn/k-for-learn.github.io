  </footer>
  <p class="toast" id="toast" role="status" aria-live="polite" hidden="">編集内容を含む確認用HTMLを保存しました。</p>

  
  <script>
(() => {
  'use strict';
  document.documentElement.classList.add('js');
  const $ = id => document.getElementById(id);
  const clean = value => typeof value === 'string' ? value.trim() : '';
  const show = (element, visible) => { if (element) element.hidden = !visible; };
  const configNode = $('portfolio-config');
  let config = {};
  try { config = JSON.parse(configNode.textContent); }
  catch (error) { console.error('portfolio-config のJSON形式を確認してください。', error); }

  function httpUrl(value) {
    const text = clean(value);
    if (!/^https?:\/\//i.test(text) || /[\u0000-\u001f\\]/.test(text)) return '';
    try {
      const url = new URL(text);
      return ['http:', 'https:'].includes(url.protocol) && !url.username && !url.password ? url.href : '';
    } catch { return ''; }
  }
  function resourceUrl(value) {
    const text = clean(value);
    if (!text || /[\u0000-\u001f\\]/.test(text)) return '';
    const absolute = httpUrl(text);
    if (absolute) return absolute;
    if (text.startsWith('//') || /^[a-z][a-z0-9+.-]*:/i.test(text) || text.startsWith('#')) return '';
    return text;
  }
  const imageDataUrl = value => {
    const text = clean(value);
    return text.length <= 7500000 && /^data:image\/(png|jpeg|webp);base64,[A-Za-z0-9+/]+=*$/.test(text) ? text : '';
  };
  const validEmail = value => /^[^\s@<>\r\n]+@[^\s@<>\r\n]+\.[^\s@<>\r\n]+$/.test(clean(value));
  const encodeConfig = value => JSON.stringify(value, null, 2).replace(/</g, '\\u003c');
  const publicationReady = value => value.reviewedForPublication === true && !!clean(value.name) &&
    (validEmail(value.email) || !!httpUrl(value.github));
  function bindLink(id, url) {
    const link = $(id);
    if (!link) return;
    if (url) link.href = url;
    else link.removeAttribute('href');
    show(link, !!url);
  }
  let toastTimer;
  function notify(message) {
    const toast = $('toast');
    toast.textContent = message;
    show(toast, true);
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => show(toast, false), 5500);
  }
  function updateView(value) {
    const name = clean(value.name);
    $('profile-name').textContent = name || 'Webエンジニア';
    $('name-en').textContent = clean(value.nameEn);
    show($('name-en'), !!clean(value.nameEn));
    show($('profile-role'), !!name);
    $('copyright-name').textContent = name || 'Portfolio';
    document.title = name ? `${name} | ポートフォリオ` : 'Webエンジニアのポートフォリオ';
    document.querySelector('meta[property="og:title"]').content = document.title;
    const email = validEmail(value.email) ? clean(value.email) : '';
    const github = httpUrl(value.github), resume = resourceUrl(value.resumeUrl);
    bindLink('email-link', email ? `mailto:${encodeURIComponent(email)}` : '');
    $('email-link').textContent = email;
    bindLink('github-link', github);
    bindLink('resume-link', resume);
    bindLink('profile-github', github);
    bindLink('profile-resume', resume);
    show($('profile-contact'), !!(email || github));
    show($('profile-links'), !!(email || github || resume));
    show($('contact-content'), !!(email || github || resume));
    show($('contact-empty'), !(email || github || resume));
    const period = clean(value.projectPeriod) || '約6か月';
    $('project-period').textContent = period;
    $('career-period').textContent = `エンジニアとしての在籍は${clean(value.careerPeriod) || '約1年'}で、上記案件には${period}携わりました。`;

    const coffee = value.coffee || {};
    bindLink('coffee-demo', httpUrl(coffee.demoUrl));
    bindLink('coffee-repo', httpUrl(coffee.repositoryUrl));
    const stack = Array.isArray(coffee.stack) ? coffee.stack.map(clean).filter(Boolean) : [];
    const stackNode = $('coffee-stack');
    stackNode.replaceChildren();
    if (stack.length) {
      const label = document.createElement('strong'); label.textContent = '使用技術'; stackNode.append(label);
      const names = document.createElement('span'); names.textContent = stack.join(' / '); stackNode.append(names);
    }
    show(stackNode, stack.length > 0);
    const image = $('coffee-image');
    const src = imageDataUrl(coffee.imageData) || resourceUrl(coffee.imageUrl);
    const alt = clean(coffee.imageAlt) || 'コーヒーノートの画面';
    image.alt = alt;
    $('coffee-image-caption').textContent = alt;
    show($('image-error'), false);
    image.onload = () => { show($('coffee-figure'), true); show($('image-error'), false); };
    image.onerror = () => { show($('coffee-figure'), false); show($('image-error'), true); };
    if (src) { show($('coffee-figure'), true); image.src = src; }
    else { image.removeAttribute('src'); show($('coffee-figure'), false); }
    const hint = $('draft-hint');
    if (hint) hint.textContent = publicationReady(value)
      ? '内容確認済みです。「編集・保存」からHTMLを保存すると、公開用ファイルを書き出します。'
      : '確認用のページです。氏名・連絡先の設定や保存は「編集・保存」から行えます。';
    configNode.textContent = '\n' + encodeConfig(value) + '\n';
  }
  updateView(config);

  const menu = $('menu-toggle'), nav = $('site-nav');
  function closeMenu() {
    nav.classList.remove('is-open'); menu.setAttribute('aria-expanded', 'false'); menu.setAttribute('aria-label', 'メニューを開く');
  }
  menu.addEventListener('click', () => {
    const open = nav.classList.toggle('is-open');
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  });
  nav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && nav.classList.contains('is-open')) { closeMenu(); menu.focus(); }
  });
  window.matchMedia('(min-width: 681px)').addEventListener('change', closeMenu);

  const editor = $('editor-dialog'), form = $('editor-form');
  if (!editor || !form) return;
  const fields = form.elements;
  const field = key => clean(fields.namedItem(key).value);
  const setField = (key, value) => { fields.namedItem(key).value = value || ''; };
  const errorNode = $('editor-error');
  function reportError(text) { errorNode.textContent = text; show(errorNode, true); errorNode.scrollIntoView({block: 'nearest'}); }
  function openEditor() {
    ['name', 'nameEn', 'email', 'github', 'resumeUrl', 'careerPeriod', 'projectPeriod'].forEach(key => setField(key, config[key]));
    const coffee = config.coffee || {};
    setField('coffeeDemo', coffee.demoUrl); setField('coffeeRepo', coffee.repositoryUrl);
    setField('coffeeStack', Array.isArray(coffee.stack) ? coffee.stack.join(', ') : '');
    setField('coffeeImageUrl', coffee.imageUrl); setField('coffeeImageAlt', coffee.imageAlt);
    setField('coffeeImageFile', '');
    fields.namedItem('removeImage').checked = false;
    fields.namedItem('reviewed').checked = config.reviewedForPublication === true;
    show(errorNode, false);
    editor.showModal(); document.body.classList.add('modal-open');
  }
  $('open-editor').addEventListener('click', openEditor);
  $('close-editor').addEventListener('click', () => editor.close());
  editor.addEventListener('close', () => document.body.classList.remove('modal-open'));
  editor.addEventListener('click', event => {
    if (event.target !== editor) return;
    const r = editor.getBoundingClientRect();
    if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) editor.close();
  });
  async function readImage(file) {
    if (!['image/png', 'image/jpeg', 'image/webp'].includes(file.type)) throw new Error('画像はPNG / JPEG / WebPで指定してください。');
    if (file.size > 5 * 1024 * 1024) throw new Error('画像は5MB以下にしてください。');
    const data = await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result));
      reader.onerror = () => reject(new Error('画像ファイルを読み込めませんでした。'));
      reader.readAsDataURL(file);
    });
    if (!imageDataUrl(data)) throw new Error('対応していない画像形式です。');
    await new Promise((resolve, reject) => {
      const image = new Image();
      image.onload = () => resolve();
      image.onerror = () => reject(new Error('画像を表示できませんでした。正常な画像ファイルを選択してください。'));
      image.src = data;
    });
    return data;
  }
  let busy = false;
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (busy) return;
    const action = event.submitter ? event.submitter.value : 'apply';
    show(errorNode, false);
    const oldCoffee = config.coffee || {};
    const next = {
      name: field('name'), nameEn: field('nameEn'), email: field('email'), github: field('github'),
      resumeUrl: field('resumeUrl'), careerPeriod: field('careerPeriod'), projectPeriod: field('projectPeriod'),
      coffee: {
        demoUrl: field('coffeeDemo'), repositoryUrl: field('coffeeRepo'),
        stack: field('coffeeStack').split(/[,、，]/).map(clean).filter(Boolean),
        imageUrl: field('coffeeImageUrl'), imageData: imageDataUrl(oldCoffee.imageData),
        imageAlt: field('coffeeImageAlt') || 'コーヒーノートの画面'
      },
      reviewedForPublication: fields.namedItem('reviewed').checked
    };
    const errors = [];
    if (next.email && !validEmail(next.email)) errors.push('メールアドレスの形式を確認してください。');
    for (const [key, label] of [['github', 'GitHub'], ['coffeeDemo', 'アプリ'], ['coffeeRepo', 'ソースコード']]) {
      if (field(key) && !httpUrl(field(key))) errors.push(`${label}はhttp://またはhttps://のURLで入力してください。`);
    }
    for (const [key, label] of [['resumeUrl', '職務経歴書'], ['coffeeImageUrl', '画像']]) {
      if (field(key) && !resourceUrl(field(key))) errors.push(`${label}はHTTP(S)のURL、または相対パスで指定してください。`);
    }
    if (next.reviewedForPublication && !publicationReady(next)) errors.push('公開用として保存するには、氏名とメールアドレスまたはGitHubプロフィールURLが必要です。');
    if (next.reviewedForPublication && !httpUrl(next.coffee.demoUrl)) errors.push('作品紹介に使うアプリの公開URLを入力してください。');
    if (errors.length) { reportError(errors.join(' ')); return; }
    const buttons = form.querySelectorAll('button[type="submit"]');
    try {
      busy = true; buttons.forEach(button => { button.disabled = true; });
      const file = fields.namedItem('coffeeImageFile').files[0];
      if (fields.namedItem('removeImage').checked) {
        next.coffee.imageUrl = ''; next.coffee.imageData = '';
      } else if (file) {
        next.coffee.imageData = await readImage(file); next.coffee.imageUrl = '';
      } else if (next.coffee.imageUrl !== clean(oldCoffee.imageUrl)) {
        next.coffee.imageData = '';
      }
      config = next; updateView(config);
      if (action === 'download') exportHtml();
      else { editor.close(); notify('画面に反映しました。変更を残すには「編集・保存」からHTMLを保存してください。'); }
    } catch (error) { reportError(error.message || '保存の準備に失敗しました。入力内容をご確認ください。'); }
    finally { busy = false; buttons.forEach(button => { button.disabled = false; }); }
  });

  function exportHtml() {
    const root = document.documentElement.cloneNode(true);
    const ready = publicationReady(config);
    root.classList.remove('js'); root.querySelector('body').classList.remove('modal-open');
    root.querySelector('#portfolio-config').textContent = '\n' + encodeConfig(config) + '\n';
    root.querySelectorAll('dialog[open]').forEach(dialog => dialog.removeAttribute('open'));
    root.querySelectorAll('button[disabled]').forEach(button => button.removeAttribute('disabled'));
    root.querySelector('#toast').hidden = true;
    root.querySelector('#editor-error').hidden = true;
    root.querySelector('#site-nav').classList.remove('is-open');
    const toggle = root.querySelector('#menu-toggle');
    toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'メニューを開く');
    if (ready) {
      root.querySelectorAll('[data-editor-only], #draft-robots').forEach(element => element.remove());
    }
    const html = '<!doctype html>\n' + root.outerHTML;
    const url = URL.createObjectURL(new Blob([html], {type: 'text/html;charset=utf-8'}));
    const link = document.createElement('a');
    link.href = url; link.download = ready ? 'index.html' : 'portfolio-draft.html';
    document.body.append(link); link.click(); link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    notify(ready ? '公開用のindex.htmlを保存しました。インターネット上への公開はまだ行っていません。' : '編集内容を含む確認用HTMLを保存しました。');
  }
})();

  </script>


