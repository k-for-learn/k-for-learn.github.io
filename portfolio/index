    <section class="document-section contact-last" id="contact" aria-labelledby="contact-title">
      <h2 class="section-label" id="contact-title">連絡先</h2>
      <div>
        <div id="contact-content">
          <p class="contact-copy">ご連絡は、下記よりお願いいたします。</p>
          <div class="contact-list">
            <a id="email-link" href="mailto:wg3qakc.tstcz3sd%40gmail.com">wg3qakc.tstcz3sd@gmail.com</a>
            <a id="github-link" target="_blank" rel="noopener noreferrer" hidden="">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新しいタブで開きます）</span></a>
            <a id="resume-link" target="_blank" rel="noopener noreferrer" hidden="">職務経歴書 <span aria-hidden="true">↗</span><span class="sr-only">（新しいタブで開きます）</span></a>
